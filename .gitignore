.eunit/*
deps/*
ebin
priv/*.so
# vendored ggml/llama runtime libs flattened into priv/ by the opt-in
# BITCASK_WITH_LLAMA build. They carry SONAME suffixes (libggml-base.so.0,
# libllama.so.0.0.1, ...) which `priv/*.so` above does NOT match.
priv/*.so.*
priv/dict/
*.o
*.beam
*~
.local_dialyzer_plt
log/
_build/*
.DS_Store
/.eqc-info
/current_counterexample.eqc
.pulse
rebar.lock

# rebar3 plugin/runtime crash dump (e.g. eqc_rebar load failure when QuickCheck
# is not installed). Harmless — does not indicate a compile failure.
rebar3.crashdump
erl_crash.dump

# CMake / C++ build (M0+)
build/
cmake-build-*/
CMakeUserPresets.json
compile_commands.json
.cache/
.ccache/

# Third-party dependencies
# NOTE: benchmark/cppjieba/googletest/limonp/oneTBB/utf8proc/unordered_dense
# are symlinks into the libbitcask submodule, so they must NOT have a trailing
# slash (gitignore trailing slash matches directories only, not symlink files).
third_party/benchmark
third_party/cppjieba
third_party/googletest
third_party/limonp
third_party/oneTBB
third_party/utf8proc
third_party/unordered_dense
third_party/libbitcask/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*.iml

# Coverage
*.gcda
*.gcno
*.gcov
coverage/
