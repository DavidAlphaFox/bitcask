{erl_opts, [debug_info, warn_untyped_record,
            {platform_define, "^[0-9]+", namespaced_types},
            {platform_define, "^[2-9][1-9]\..*", dirty_file_nif}]}.

{minimum_otp_vsn, "22.0"}.

{profiles,
 [
  {prod,
   [
    {erl_opts, [warnings_as_errors]}
   ]},
  {gha, [{erl_opts, [{d, 'GITHUBEXCLUDE'}]}]},
  {test,
   [
    {deps,
     [meck,
     {cuttlefish, {git, "https://github.com/kyorai/cuttlefish.git", {tag, "v3.0.1"}}}
     ]},
    {eunit_opts, [verbose]}
   ]}
 ]}.

%% C++23 build via cmake. Produces priv/bitcask_cpp.so loaded by
%% bitcask_cpp_nifs. The configure step is skipped if _build/cmake exists,
%% so the per-compile overhead is just a no-op `cmake --build` (~50ms when
%% nothing changed). BUILD_TESTING=OFF keeps GoogleTest off the default
%% critical path; to run C++ tests use
%% `cmake -B _build/cmake -DBUILD_TESTING=ON && ctest`.
{pre_hooks,
 [
  {compile,
   "sh -c 'test -f _build/cmake/CMakeCache.txt || "
   "cmake -S . -B _build/cmake -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release'"},
  {compile,
   "cmake --build _build/cmake --target bitcask_cpp -j"}
 ]}.

{post_hooks,
 [
  {clean, "sh -c 'rm -rf _build/cmake priv/bitcask_cpp.so'"}
 ]}.

{xref_checks,[undefined_function_calls,undefined_functions,locals_not_used,
              deprecated_function_calls, deprecated_functions]}.
