{erl_opts, [debug_info, warn_untyped_record,
            {platform_define, "^[0-9]+", namespaced_types},
            {platform_define, "^[2-9][1-9]\..*", dirty_file_nif}]}.

{minimum_otp_vsn, "22.0"}.

{profiles,
 [
  {prod,
   [
    {erl_opts, [warnings_as_errors]}
   ]},
  {gha, [{erl_opts, [{d, 'GITHUBEXCLUDE'}]}]},
  {test,
   [
    {deps,
     [meck,
     {cuttlefish, {git, "https://github.com/kyorai/cuttlefish.git", {tag, "v3.0.1"}}}
     ]},
    {eunit_opts, [verbose]}
   ]}
 ]}.

%% C++23 build via cmake. Produces priv/bitcask_cpp.so loaded by
%% bitcask_cpp_nifs. The configure step is skipped if _build/cmake exists,
%% so the per-compile overhead is just a no-op `cmake --build` (~50ms when
%% nothing changed). BUILD_TESTING=OFF keeps GoogleTest off the default
%% critical path; to run C++ tests use
%% `cmake -B _build/cmake -DBUILD_TESTING=ON && ctest`.
%%
%% Submodule init must run *before* configure: the vendored third_party
%% tree (icu / cppjieba / googletest / zlib / ...) lives inside the
%% third_party/libbitcask submodule and is itself a set of nested
%% submodules, so a plain (non-recursive) `git submodule update --init`
%% leaves e.g. `third_party/libbitcask/third_party/cppjieba/` empty and
%% CMake's EXISTS check fails.
%% ⚠️ ICU (6.3+) is the one deliberate exception: its submodule is marked
%% `update = none` (~380 MB), so `--recursive` skips it silently. The
%% default BITCASK_ICU_PROVIDER=auto uses the system libicu-dev instead;
%% only opt-in vendored builds need the explicit
%% `git -c submodule.third_party/icu.update=checkout submodule update
%% --init --depth 1 third_party/icu` inside third_party/libbitcask.
%% Guarded by `test -d .git` so tarball/extracted deployments skip it.
%%
%% ⚠️ The libbitcask init is **path-scoped on purpose**. A bare
%% `git submodule update --init --recursive` would also pull
%% third_party/llama.cpp -- ~200 MB imposed on every user of this library,
%% including the vast majority who never turn the local embedder on. The
%% llama.cpp submodule is fetched by the next hook, only when asked for.
%%
%% Local llama.cpp embedding backend (priv/bitcask_llama.so + the vendored
%% ggml/llama shared libs) is **opt-in**:
%%
%%     BITCASK_WITH_LLAMA=1 rebar3 compile
%%
%% Anything other than `1` leaves the build byte-for-byte as it was before
%% the backend existed: no submodule fetch, no CMake flag, no extra target.
%% Flipping the variable re-configures automatically -- the grep below
%% compares the desired value against what is already in CMakeCache.txt, so
%% the steady-state cost stays a no-op `cmake --build`.
{pre_hooks,
 [
  {compile,
   "sh -c 'test -d .git && git submodule update --init --recursive third_party/libbitcask'"},
  {compile,
   "sh -c 'test \"$BITCASK_WITH_LLAMA\" = 1 || exit 0; test -d .git || exit 0; "
   "git submodule update --init third_party/llama.cpp'"},
  {compile,
   "sh -c 'LLAMA=OFF; test \"$BITCASK_WITH_LLAMA\" = 1 && LLAMA=ON; "
   "grep -qx \"BITCASK_WITH_LLAMA:BOOL=$LLAMA\" _build/cmake/CMakeCache.txt 2>/dev/null || "
   "cmake -S . -B _build/cmake -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release "
   "-DBITCASK_WITH_LLAMA=$LLAMA'"},
  {compile,
   "cmake --build _build/cmake --target bitcask_cpp -j"},
  {compile,
   "sh -c 'test \"$BITCASK_WITH_LLAMA\" = 1 || exit 0; "
   "cmake --build _build/cmake --target bitcask_llama -j'"}
 ]}.

%% priv/libggml-* / priv/libllama* are the vendored shared libs flattened in
%% by cpp/llama/CMakeLists.txt; they only exist in opt-in builds.
{post_hooks,
 [
  {clean, "sh -c 'rm -rf _build/cmake priv/bitcask_cpp.so priv/bitcask_llama.so "
          "priv/libggml* priv/libllama*'"}
 ]}.

%% inets 只被 HTTP 档的 embedder 用到（httpc:request/4），它不在 bitcask 的
%% applications 列表里——那是**有意的**：绝大多数部署不配 embedder，不该为此把
%% inets 变成 bitcask 的启动依赖（用到时由 application:ensure_all_started/1 拉起）。
%% 但 dialyzer 的 PLT 是按 applications 建的，于是那几处调用报 "Unknown function
%% httpc:request/4"。加进 plt_extra_apps 让分析看得见它，同时不改变运行期依赖。
{dialyzer, [{plt_extra_apps, [inets]}]}.

{xref_checks,[undefined_function_calls,undefined_functions,locals_not_used,
              deprecated_function_calls, deprecated_functions]}.
