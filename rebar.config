{erl_opts, [debug_info, warn_untyped_record,
            {platform_define, "^[0-9]+", namespaced_types},
            {platform_define, "^[2-9][1-9]\..*", dirty_file_nif}]}.

%% 27+: bitcask_embedder_util 用 stdlib json（OTP 27 新增）。
{minimum_otp_vsn, "27"}.

{profiles,
 [
  {prod,
   [
    {erl_opts, [warnings_as_errors]}
   ]},
  {gha, [{erl_opts, [{d, 'GITHUBEXCLUDE'}]}]},
  {test,
   [
    {deps,
     [meck,
     {cuttlefish, {git, "https://github.com/kyorai/cuttlefish.git", {tag, "v3.0.1"}}}
     ]},
    {eunit_opts, [verbose]}
   ]}
 ]}.

%% C++23 build via cmake. Produces priv/bitcask_cpp.so loaded by
%% bitcask_cpp_nifs. Steady state is a no-op `cmake --build` (~50ms when
%% nothing changed): the configure hook only runs cmake when something it
%% depends on changed (see below). BUILD_TESTING=OFF keeps GoogleTest off the
%% default critical path; to run C++ tests use
%% `cmake -B _build/cmake -DBUILD_TESTING=ON && ctest`.
%%
%% Submodule init must run *before* configure: the vendored third_party
%% tree (icu / cppjieba / googletest / zlib / ...) lives inside the
%% third_party/libbitcask submodule and is itself a set of nested
%% submodules, so a plain (non-recursive) `git submodule update --init`
%% leaves e.g. `third_party/libbitcask/third_party/cppjieba/` empty and
%% CMake's EXISTS check fails.
%% ⚠️ ICU (6.3+) is the one deliberate exception: its submodule is marked
%% `update = none` (~380 MB), so `--recursive` skips it silently. The
%% default BITCASK_ICU_PROVIDER=auto uses the system libicu-dev instead;
%% only opt-in vendored builds need the explicit
%% `git -c submodule.third_party/icu.update=checkout submodule update
%% --init --depth 1 third_party/icu` inside third_party/libbitcask.
%%
%% The submodule hook only **initialises an empty checkout**:
%%   * `test -e .git || exit 0` — tarball / hex installs have no .git and
%%     must not fail the compile. `-e`, not `-d`: in a git worktree, or when
%%     this repo is itself vendored as a submodule, `.git` is a *file*. (The
%%     old `test -d .git && …` exited 1 in all of those cases and broke
%%     `rebar3 compile`.)
%%   * it runs `git submodule update` only when third_party/libbitcask is
%%     empty. The old hook ran it on every compile, which checks the
%%     submodule back out to the commit pinned in the parent's **index** —
%%     silently undoing a local bump that wasn't `git add`ed yet (bit us in
%%     M8-1: the build fell back to the old version with errors that looked
%%     like code bugs).
%%     ⚠️ Flip side: after pulling a commit that moves the pin, run
%%     `git submodule update --init --recursive third_party/libbitcask`
%%     yourself — compile no longer does it for you.
%%
%% ⚠️ The libbitcask init is **path-scoped on purpose**. A bare
%% `git submodule update --init --recursive` would also pull
%% third_party/llama.cpp -- ~200 MB imposed on every user of this library,
%% including the vast majority who never turn the local embedder on. The
%% llama.cpp submodule is fetched by the next hook, only when asked for.
%%
%% Local llama.cpp embedding backend (priv/bitcask_llama.so + the vendored
%% ggml/llama shared libs) is **opt-in**:
%%
%%     BITCASK_WITH_LLAMA=1 rebar3 compile
%%
%% Anything other than `1` leaves the build byte-for-byte as it was before
%% the backend existed: no submodule fetch, no CMake flag, no extra target.
%%
%% Configure hook — re-runs cmake only when one of these differs from
%% _build/cmake/CMakeCache.txt, so the steady-state cost stays a no-op:
%%   * BITCASK_WITH_LLAMA (1 → ON, anything else → OFF);
%%   * BITCASK_LTO (env, default ON = release behaviour). libbitcask builds
%%     its objects with -flto, so every relink of priv/bitcask_cpp.so runs a
%%     whole-program LTO pass; `BITCASK_LTO=OFF rebar3 compile` for fast
%%     edit-compile loops;
%%   * the OTP install: rebar3 exports ERLANG_ROOT_DIR (the VM running this
%%     compile) to hooks. If the cached Erlang_INCLUDE_DIR is not under it
%%     (switched OTP via mise/kerl/asdf), CMakeCache.txt is dropped and cmake
%%     re-detects with ERL_EXECUTABLE pinned to that VM — otherwise the NIF
%%     silently keeps compiling against the old erl_nif.h (FindErlang caches
%%     the include dir). Only the cache file is removed, not CMakeFiles/, so
%%     unchanged objects are not rebuilt. Skipped when ERL_INCLUDE_DIR is set
%%     (explicit override).
%% A *fresh* _build/cmake uses Ninja when it is on PATH; an existing
%% Makefiles tree stays on Makefiles (CMake refuses to switch generators in
%% place — `make distclean` first to switch). ccache, when on PATH, is set
%% as the compiler launcher.
%%
%% Build parallelism is bounded by nproc (it honours CPU affinity / cgroup
%% cpusets). A bare `-j` means *unlimited* jobs to make.
{pre_hooks,
 [
  {compile,
   "sh -c 'test -e .git || exit 0; "
   "test -e third_party/libbitcask/CMakeLists.txt || "
   "git submodule update --init --recursive third_party/libbitcask'"},
  {compile,
   "sh -c 'test \"$BITCASK_WITH_LLAMA\" = 1 || exit 0; test -e .git || exit 0; "
   "test -e third_party/llama.cpp/CMakeLists.txt || "
   "git submodule update --init third_party/llama.cpp'"},
  {compile,
   "sh -c 'C=_build/cmake/CMakeCache.txt; "
   "LLAMA=OFF; test \"$BITCASK_WITH_LLAMA\" = 1 && LLAMA=ON; "
   "LTO=${BITCASK_LTO:-ON}; "
   "STALE_ERL=0; "
   "if test -f $C && test -z \"$ERL_INCLUDE_DIR\" && test -n \"$ERLANG_ROOT_DIR\" && "
   "! grep -q \"^Erlang_INCLUDE_DIR:PATH=$ERLANG_ROOT_DIR/\" $C; then "
   "echo \"bitcask: OTP changed ($ERLANG_ROOT_DIR), re-detecting erl_nif.h\"; "
   "rm -f $C; STALE_ERL=1; fi; "
   "grep -qx \"BITCASK_WITH_LLAMA:BOOL=$LLAMA\" $C 2>/dev/null && "
   "grep -qx \"BITCASK_LTO:BOOL=$LTO\" $C && exit 0; "
   "GEN=; test -f _build/cmake/Makefile || test -f _build/cmake/build.ninja || "
   "{ command -v ninja >/dev/null 2>&1 && GEN=\"-G Ninja\"; }; "
   "test -f _build/cmake/Makefile && GEN=; "
   "LAUNCH=; command -v ccache >/dev/null 2>&1 && "
   "LAUNCH=\"-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache\"; "
   "ERLX=; test \"$STALE_ERL\" = 1 && ERLX=\"-DERL_EXECUTABLE=$ERLANG_ROOT_DIR/bin/erl\"; "
   "cmake -S . -B _build/cmake $GEN $LAUNCH $ERLX -DBUILD_TESTING=OFF "
   "-DCMAKE_BUILD_TYPE=Release -DBITCASK_WITH_LLAMA=$LLAMA -DBITCASK_LTO=$LTO'"},
  {compile,
   "sh -c 'cmake --build _build/cmake --target bitcask_cpp "
   "--parallel \"$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)\"'"},
  {compile,
   "sh -c 'test \"$BITCASK_WITH_LLAMA\" = 1 || exit 0; "
   "cmake --build _build/cmake --target bitcask_llama "
   "--parallel \"$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)\"'"}
 ]}.

%% priv/libggml-* / priv/libllama* are the vendored shared libs flattened in
%% by cpp/llama/CMakeLists.txt; they only exist in opt-in builds.
%% `rebar3 clean` keeps _build/cmake (the C++ objects): wiping it meant a full
%% rebuild of all of libbitcask after every clean. `make distclean` removes it.
{post_hooks,
 [
  {clean, "sh -c 'rm -f priv/bitcask_cpp.so priv/bitcask_llama.so "
          "priv/libggml* priv/libllama*'"}
 ]}.

%% inets 只被 HTTP 档的 embedder 用到（httpc:request/4），它不在 bitcask 的
%% applications 列表里——那是**有意的**：绝大多数部署不配 embedder，不该为此把
%% inets 变成 bitcask 的启动依赖（用到时由 application:ensure_all_started/1 拉起）。
%% 但 dialyzer 的 PLT 是按 applications 建的，于是那几处调用报 "Unknown function
%% httpc:request/4"。加进 plt_extra_apps 让分析看得见它，同时不改变运行期依赖。
{dialyzer, [{plt_extra_apps, [inets]}]}.

{xref_checks,[undefined_function_calls,undefined_functions,locals_not_used,
              deprecated_function_calls, deprecated_functions]}.
